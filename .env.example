# 對外網址：QR code 會指向 ${PUBLIC_URL}/r/<房間代碼>
# 若用反向代理，填代理後的網址（含 https 與非預設 port）
PUBLIC_URL=http://192.168.1.10:8080

# 管理頁與播放頁的登入密碼
ADMIN_PASSWORD=change-me

# 主機上的歌曲資料夾（會以唯讀方式掛載）
MEDIA_PATH=/path/to/karaoke

# 對外 port
PORT=8080

# 檔名格式：artist-title（歌手 - 歌名）、title-artist（歌名 - 歌手）、title（整個檔名當歌名）
FILENAME_FORMAT=artist-title
# 歌手與歌名之間的分隔字串（要保留空白請加引號）
FILENAME_SEPARATOR=" - "

# 原唱版影片的檔名後綴（留空表示不啟用）。設定後，檔名以此結尾的檔案不會列為歌曲，
# 而是成為同名歌曲的原唱版，手機上可以切換「原唱」（伴唱畫面 + 原唱聲音）。
# 例如設為 _original，則「周杰倫 - 晴天_original.mp4」對應「周杰倫 - 晴天.mp4」
ORIGINAL_SUFFIX=

# 要掃描的副檔名，逗號分隔（瀏覽器要能直接播放；播放端支援 .mkv 的話可以加上）
MEDIA_EXTENSIONS=.mp4,.m4v,.webm

# 要使用的 image 版本：latest（main 分支最新版）或發行版號，例如 1.0.0
ZKARAVER_TAG=latest
